[init]
  defaultBranch = main

[delta]
  # follow the terminal's 16 colours (Herdr's graphite)
  syntax-theme = ansi
  dark = true
  # diff backgrounds = nvim's DiffAdd / DiffDelete (as in diffview.nvim); emph is a stronger tint
  plus-style = syntax "#313732"
  minus-style = syntax "#3a2e33"
  plus-emph-style = syntax "#424a40"
  minus-emph-style = syntax "#523b41"
  line-numbers-plus-style = "#a6bd91"
  line-numbers-minus-style = "#dc8c95"
  line-numbers-zero-style = "#3c3f45"
  line-numbers-left-style = "#3c3f45"
  line-numbers-right-style = "#3c3f45"

[core]
  excludesfile = ~/.dotfiles/.cvsignore
  attributesfile = ~/.dotfiles/.gitattributes

[diff]
  tool = difftastic
  external = difft

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

[user]
  name = Rainer Borene
  email = rainerborene@gmail.com

[grep]
  extendedRegexp = true
  lineNumber = true

[push]
  default = current

[pull]
  rebase = true

[color]
  ui = auto

[merge]
  summary = true
  prompt = false
  tool = fugitive

[mergetool]
  keepBackup = false
  keepTemporaries = false

[mergetool "fugitive"]
  cmd = "nvim -f -c 'Gvdiffsplit' $MERGED"

[alias]
  a                 = add
  s                 = status
  p                 = push
  d                 = diff
  ba                = branch -a
  dc                = diff --cached
  co                = checkout
  ci                = commit
  uns               = reset HEAD
  unstage           = reset HEAD
  l                 = log -16 --color=always --all --topo-order --pretty='format:%Cgreen%h%Creset %s%Cred%d%Creset %C(blue bold)(by %an)%Creset'
  ll                = log --color=always --all --topo-order --pretty='format:%Cgreen%h%Creset %s%Cred%d%Creset %C(blue bold)(by %an)%Creset'
  gl                = log -10 --color=always --all --graph --topo-order --pretty='format:%Cgreen%h%Creset %s %C(blue bold)(by %an)%Creset%C(yellow bold)%d%Creset%n'
  gll               = log --color=always --all --graph --topo-order --pretty='format:%Cgreen%h%Creset %s %C(blue bold)(by %an)%Creset%C(yellow bold)%d%Creset%n'
  changed           = git diff-tree --no-commit-id --name-only -r
  work              = !sh -c 'git fetch && git checkout @{upstream} -tb \"$@\"'
  dft               = difftool
  dlog              = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
